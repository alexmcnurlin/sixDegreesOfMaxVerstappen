{
    "scripts": {
        "prebuild-client": "cp config.development.json client/config.json",
        "prebuild-server": "cp config.development.json server/config.json",
        "prestart-client": "cp config.development.json client/config.json",
        "prestart-server": "cp config.development.json server/config.json",

        "build-client": "npm run build --prefix client",
        "build-server": "npm run build --prefix server",
        "prebuild": "npm run gql",
        "build": "concurrently npm:build-*",

        "start-client": "npm run build --prefix client && npm run start --prefix client",
        "start-server": "concurrently --names build,start \"npm run build-watch --prefix server\" \"npm run start-watch --prefix server\"",
        "prestart": "npm run gql",
        "start": "concurrently npm:start-*",

        "gql": "graphql-codegen",

        "install": "concurrently --names server,client \"npm install --prefix server\" \"npm install --prefix client\""
    },
  "devDependencies": {
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/client-preset": "^5.2.2",
    "@graphql-codegen/typescript": "^5.0.7",
    "@graphql-codegen/typescript-resolvers": "^5.1.5",
    "concurrently": "^9.2.1"
  }
}
