{
    "compilerOptions": {
        "rootDirs": [
            "src"
        ],
        "outDir": "dist",
        "lib": [
            "es2023"
        ],
        "target": "es2023",
        "module": "es2022",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "types": [
            "node",
            "jest"
        ],
    },
    // Don't copy over test files. If you do, Jest will try to run tests twice
    // (and complain that it's not TypeScript)
    "exclude": ["**/*.test.ts", "**/*.spec.ts", "tests", "__tests__"]
}
